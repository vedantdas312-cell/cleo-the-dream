# Template only. Set credentials securely in the process environment.
# No script automatically loads this file.
KEIKI_API_KEY=
KEIKI_AGENT_ID=
KEIKI_BASE_URL=https://onkeiki.com/api/v1/openai
GOOGLE_ACCESS_TOKEN=

# Cleo iMessage redline webhook server (Node 24 / Maritime / PostgreSQL)
DATABASE_URL=
PORT=3000
PUBLIC_URL=
# Must match Keiki's X-Orchid-Api-Key webhook header. Never expose to the model.
KEIKI_WEBHOOK_KEY=
DOWNLOAD_SIGNING_SECRET=
# Exact HTTPS origin(s) of Keiki's authenticated attachment URLs; no wildcards.
KEIKI_ATTACHMENT_ORIGINS=

# Optional local shared contract context (never commit actual values)
SUPERMEMORY_API_KEY=
CLEO_CONTEXT_DB=
# Set only for a loopback-only SQLite backend; otherwise PostgreSQL remains required.
CLEO_LOCAL_DB=
# Google refresh-token setup: npm run google:authorize (see docs/cleo-shared-memory.md)
# Separate desktop context credential and server-side binding to one explicit sender.
CLEO_DESKTOP_TOKEN=
CLEO_DESKTOP_SENDER=
# Hosted only: encrypted runtime secrets containing the same OAuth JSON objects.
CLEO_GOOGLE_CLIENT_JSON=
CLEO_GOOGLE_OAUTH_JSON=
# Optional existing sender who explicitly authorized link-public generated reviews.
# Empty by default. New users receive private Word/PDF files and a saved meeting view.
CLEO_PUBLIC_REVIEW_SENDER=

# Meeting attendance is opt-in after configuring authenticated direct-message controls.
CLEO_MEETINGS_ENABLED=false
CLEO_MEETING_DB=/data/cleo/meetings.sqlite
ATTENDEE_API_KEY=
# Optional extra verification in addition to unguessable per-bot callback capabilities.
ATTENDEE_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Exact provider-stamped iMessage line for the existing Cleo conversation.
# Dedicated-line identity callbacks and authenticated legacy ChannelEnvelope tools are supported.
KEIKI_IMESSAGE_LINE=
KEIKI_IDENTITY_SECRET=
# Separate credential with agents:write for private notices (queueing is not delivery).
KEIKI_NOTICE_API_KEY=

# Optional dedicated Maritime Computers credential for the Google Docs presentation browser.
MARITIME_COMPUTERS_KEY=
